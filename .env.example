# Copy to .env. Do not commit .env. Values below are names only.

# duckdb for a local volume, snowflake for the live warehouse.
CHURN_BACKEND=duckdb
CHURN_DUCKDB_PATH=artefacts/local.duckdb
CHURN_CONFIG_DIR=/app/config
CHURN_CONTRACT_PATH=config/source_contract.yaml
CHURN_KEY_PEPPER=
CHURN_API_KEY=

# LLM copy. Leave blank to stay on the template.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Snowflake. Use a key file mounted into the container, or a password.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
